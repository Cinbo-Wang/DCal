# Sparse PS
gamma_true <- rep(0, p)
act_loc <- 1:s_or
gamma_true[act_loc] <- runif(length(act_loc), 1, 2)
gamma_true <- gamma_true / norm(gamma_true, type = '2')

U <- X \%*\% gamma_true
pi_W <- 1 / (1 + exp(-U))
W <- rbinom(n, size = 1, p = pi_W)

